{
	"info": {
		"name": "Products Error Handling",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Setup: Create product for error tests",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 201', () => pm.response.to.have.status(201));",
							"pm.collectionVariables.set('errTestToken', 'err-test-token');"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\"name\": \"Error Test Widget\", \"productToken\": \"err-test-token\", \"price\": \"9.99\", \"stock\": 10}"
				},
				"url": {
					"raw": "{{baseUrl}}/v1/products",
					"host": ["{{baseUrl}}"],
					"path": ["v1", "products"]
				}
			}
		},
		{
			"name": "409 Conflict: Duplicate productToken",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 409', () => pm.response.to.have.status(409));",
							"const json = pm.response.json();",
							"pm.test('Has statusCode 409', () => pm.expect(json.statusCode).to.eql(409));",
							"pm.test('Has error field', () => pm.expect(json.error).to.be.a('string'));",
							"pm.test('Has message field', () => pm.expect(json.message).to.be.a('string'));",
							"pm.test('Has path field', () => pm.expect(json.path).to.be.a('string'));",
							"pm.test('Has timestamp field', () => pm.expect(json.timestamp).to.be.a('string'));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\"name\": \"Duplicate Widget\", \"productToken\": \"err-test-token\", \"price\": \"5.00\", \"stock\": 5}"
				},
				"url": {
					"raw": "{{baseUrl}}/v1/products",
					"host": ["{{baseUrl}}"],
					"path": ["v1", "products"]
				}
			}
		},
