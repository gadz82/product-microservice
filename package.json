{
	"name": "product-nest",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"setup": "npm ci && npx husky",
		"run-dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
		"start:dev": "nest start --watch",
		"db:migrate": "node -r ts-node/register ./node_modules/.bin/sequelize db:migrate --config database/config/config.ts --migrations-path database/migrations",
		"db:migrate:undo": "node -r ts-node/register ./node_modules/.bin/sequelize db:migrate:undo --config database/config/config.ts --migrations-path database/migrations",
		"db:migration:generate": "node -r ts-node/register ./node_modules/.bin/sequelize migration:generate --config database/config/config.ts --migrations-path database/migrations --name",
		"unit-test": "jest --coverage",
		"integration-test": "newman run tests/integration/products.collection.json -e tests/integration/environment.json --reporters cli",
  		"integration-test:pagination": "newman run tests/integration/pagination.collection.json -e tests/integration/environment.json --reporters cli",
  		"integration-test:errors": "newman run tests/integration/error-handling.collection.json -e tests/integration/environment.json --reporters cli",
		"integration-test:all": "npm run integration-test && npm run integration-test:pagination && npm run integration-test:errors",
		"lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"build": "rm -rf dist tsconfig.tsbuildinfo && nest build",
		"start": "nest start",
		"test": "npm run run-unit-test",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"engines": {
		"node": ">=22"
	},
	"type": "commonjs",
	"dependencies": {
		"@nestjs/common": "11.1.24",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.1.24",
		"@nestjs/platform-express": "11.1.24",
		"@nestjs/sequelize": "11.0.1",
		"@nestjs/swagger": "^11.4.4",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"ioredis": "^5.11.1",
		"mysql2": "3.22.5",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"sequelize": "6.37.8",
		"sequelize-typescript": "2.1.6",
		"swagger-ui-express": "^5.0.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@nestjs/cli": "11.0.21",
		"@nestjs/schematics": "11.1.0",
		"@nestjs/testing": "11.1.24",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/git": "10.0.1",
		"@types/express": "^5.0.6",
		"@types/ioredis": "^4.28.10",
		"@types/jest": "30.0.0",
		"@types/node": "25.9.2",
		"@typescript-eslint/eslint-plugin": "8.60.1",
		"@typescript-eslint/parser": "8.60.1",
		"eslint": "10.4.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "9.1.7",
		"jest": "^30.4.2",
		"newman": "6.2.2",
		"prettier": "3.8.3",
		"semantic-release": "24.2.9",
		"sequelize-cli": "6.6.5",
		"ts-jest": "^29.4.11",
		"ts-loader": "9.6.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3"
	},
	"overrides": {
		"handlebars": "4.7.9"
	}
}
